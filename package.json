{
  "name": "@kirnu/arabic-core",
  "version": "0.1.1",
  "description": "Arabic number-to-words (tafgeet) with correct grammar, currency amounts in words, tashkeel removal, Arabic normalisation and Umm al-Qura Hijri dates. No dependencies, no DOM.",
  "license": "MIT",
  "author": "Kirnu (https://getkirnu.com)",
  "homepage": "https://getkirnu.com/ar/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getkirnu/arabic-core.git"
  },
  "bugs": {
    "url": "https://github.com/getkirnu/arabic-core/issues"
  },
  "keywords": [
    "arabic",
    "tafgeet",
    "number-to-words",
    "arabic-numbers",
    "currency-to-words",
    "tashkeel",
    "arabic-normalization",
    "hijri",
    "umm-al-qura",
    "islamic-calendar",
    "rtl"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./src": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "generate:ummalqura": "node scripts/generate-ummalqura.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
